{
    "name" : "coka/service-discovery-bundle",
    "type" : "symfony-bundle",
    "description" : "Symfony bundle that implement Client Side Service Discovery pattern.",
    "homepage" : "https://github.com/CedrickOka/service-discovery-bundle",
    "license" : "MIT",
    "keywords" : [
        "service",
        "discovery",
        "registry"
    ],
    "authors" : [{
            "name" : "Cedrick Oka",
            "email" : "okacedrick@gmail.com"
        }
    ],
    "autoload" : {
        "psr-4" : {
            "Oka\\ServiceDiscoveryBundle\\" : "src/"
        },
        "exclude-from-classmap" : [
            "/tests/"
        ]
    },
    "autoload-dev" : {
        "psr-4" : {
            "Oka\\ServiceDiscoveryBundle\\Tests\\" : "tests/"
        }
    },
    "require" : {
        "php": ">=8.1",
        "symfony/cache": "^5.4 || ^6.4 || ^7.4",
        "symfony/config": "^5.4 || ^6.4 || ^7.4",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.4",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.4"
    },
    "require-dev" : {
        "friendsofphp/consul-php-sdk": "^5.0",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.4",
        "symfony/phpunit-bridge": "^5.4 || ^6.4 || ^7.4",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.4"
    },
    "config" : {
        "sort-packages" : true
    },
    "extra" : {
        "branch-alias" : {
            "dev-master" : "1.x-dev"
        },
        "symfony" : {
            "allow-contrib" : "true"
        }
    },
    "support" : {
        "docs" : "https://github.com/CedrickOka/service-discovery-bundle/blob/master/docs/index.md"
    }
}
